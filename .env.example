# Copy to .env (mode 600). Generated passwords; never reuse elsewhere.
POSTGRES_PASSWORD=change-me
# Host port for the database (loopback only).
POSTGRES_PORT=5443
# Acute thresholds. Both unset = detector logs candidates and sends nothing.
#ACUTE_Z=
#ACUTE_N=
# Read-only role for the web app and the agent (scripts/create-reader.sh).
READER_PASSWORD=change-me-too
# Cloudflare Radar outage annotations (optional). A free account API token
# with Account > Radar > Read. Unset = the radar adapter is skipped.
# Data is CC BY-NC 4.0.
#CLOUDFLARE_RADAR_TOKEN=
